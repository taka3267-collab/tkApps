        },
        "zh-Hans": {
          "title": "日记 - 记录今天的笔记",
          "detail": "轻松记录今天心情与点滴的日记应用"
        }
      }
    },
    "bookdeck": {
      "appStoreId": "6811623217",
      "icon": "icons/bookdeck.png",
      "localizations": {
        "ja": {
          "title": "読書記録・本棚管理",
          "detail": "読んだ本・読んでいる本・これから読む本をシンプルに記録"
        },
        "en": {
          "title": "Reading Log & Bookshelf",
          "detail": "Simply keep track of books you've read, are reading, and want to read."
        },
        "ko": {
          "title": "독서 기록·책장 관리",
          "detail": "읽은 책, 읽고 있는 책, 앞으로 읽을 책을 간단하게 기록"
        },
        "zh-Hans": {
          "title": "读书记录·书架管理",
          "detail": "简单记录读过的书、正在读的书和想读的书"
        }
      }
    },
    "quicknote": {
      "appStoreId": "6813859908",
      "icon": "icons/quicknote.png",
      "localizations": {
        "ja": {
          "title": "クイックノート",
          "detail": "思いついたことをさっと書ける、軽快でシンプルなメモ帳"
        },
        "en": {
          "title": "Quick Note",
          "detail": "A light, simple notepad for jotting things down the moment they come to mind"
        },
        "ko": {
          "title": "퀵 노트",
          "detail": "떠오른 생각을 바로 적을 수 있는 가볍고 심플한 메모장"
        },
        "zh-Hans": {
          "title": "快速笔记",
          "detail": "灵感一闪即可记录的轻快简洁记事本"
        }
      }
    },
    "focuscamera": {
      "appStoreId": "6815692837",
      "icon": "icons/focuscamera.png",
      "localizations": {
        "ja": {
          "title": "集中カメラ",
          "detail": "自分を映して、離席・よそ見を知らせる集中タイマー"
        },
        "en": {
          "title": "Focus Camera",
          "detail": "A focus timer that watches you and flags when you step away or look elsewhere"
        },
        "ko": {
          "title": "집중 카메라",
          "detail": "자신을 비춰 자리 비움·한눈팔기를 알려주는 집중 타이머"
        },
        "zh-Hans": {
          "title": "专注相机",
